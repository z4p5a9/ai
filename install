#!/usr/bin/env bash
# Links this repo's AGENTS.md and skills into Claude Code and Codex. Safe to rerun.
# usage: install
#   AGENTS.md becomes the instructions, and every skills/<name> becomes a skill.
#   Claude Code gets them in ${CLAUDE_CONFIG_DIR:-~/.claude}, Codex in ${CODEX_HOME:-~/.codex}.
#   It leaves alone any file, and any link into another place, that already holds one of those names, and exits 1 after.
set -euo pipefail

repo=$(cd "$(dirname "$0")" && pwd -P)
claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
codex_home=${CODEX_HOME:-$HOME/.codex}
status=0

link() { # link <source> <destination>
  local source=$1 destination=$2
  if [ -L "$destination" ]; then
    [ "$(readlink "$destination")" = "$source" ] && return 0
    # A dangling link loses nothing when replaced. A live one into another place is someone else's.
    if [ -e "$destination" ] && [[ "$(readlink "$destination")" != "$repo"/* ]]; then
      echo "install: $destination points to $(readlink "$destination"), left as it is" >&2
      status=1
      return 0
    fi
  elif [ -e "$destination" ]; then
    echo "install: $destination is a real file or folder, left as it is" >&2
    status=1
    return 0
  fi
  ln -sfn "$source" "$destination"
  echo "linked $destination"
}

for home in "$claude_home" "$codex_home"; do
  mkdir -p "$home/skills"
  if [ "$home" = "$claude_home" ]; then
    link "$repo/AGENTS.md" "$home/CLAUDE.md"
  else
    link "$repo/AGENTS.md" "$home/AGENTS.md"
  fi
  for dir in "$repo"/skills/*/; do
    link "${dir%/}" "$home/skills/$(basename "$dir")"
  done
  # A skill deleted from the repo leaves its link dangling.
  for destination in "$home"/skills/*; do
    if [ -L "$destination" ] && [ ! -e "$destination" ] && [[ "$(readlink "$destination")" == "$repo"/* ]]; then
      rm "$destination"
      echo "removed $destination"
    fi
  done
done

exit "$status"
